# Querywise environment template. PLACEHOLDERS ONLY: copy to .env (git-ignored) and fill in locally.
# Empty values mean "not set": the app then uses settings saved from the UI (Settings), then defaults.
# Precedence at runtime: environment variable > value saved in the local app-state DB > default.

# --- AI provider ------------------------------------------------------------------
# demo | ollama | anthropic. Leave empty to choose in the UI.
AI_PROVIDER=
# Anthropic (Claude). Leave empty to paste the key in Settings instead (stored encrypted).
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. Setting a value here locks the field in the UI.
ANTHROPIC_MODEL=
# low | medium (default) | high | xhigh | max
ANTHROPIC_EFFORT=
# Only for API keys not scoped to a workspace: the workspace ID, sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=
# Server-side refusal fallback for Opus 5.5 / Opus 5 / Fable 5.1 / Sonnet 5.5: on (default) | off
ANTHROPIC_FALLBACKS=
# Ollama. Setting OLLAMA_URL locks it in the UI; OLLAMA_DEFAULT_URL is only the fallback default.
OLLAMA_URL=
OLLAMA_DEFAULT_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# --- App state and secret encryption -------------------------------------------------
# Passphrase used to encrypt saved keys/passwords. If empty, a random key file is generated
# next to the state DB (.querywise/secret.key, git-ignored). Changing it makes saved secrets unreadable.
QUERYWISE_SECRET_KEY=
# Where the app-state DB lives. Default: ./.querywise (Docker: /app/state volume).
# QUERYWISE_STATE_DIR=
# Extra Host headers to accept besides localhost/127.0.0.1 (comma-separated).
# QUERYWISE_ALLOWED_HOSTS=

# --- Data sources --------------------------------------------------------------------
# Optional PostgreSQL with the Northstar schema (use a dedicated read-only role; see README).
# DATABASE_URL=postgresql+psycopg://querywise_reader:CHANGE_ME@host.docker.internal:5432/querywise
# Secret-free registry of extra sources (generated by pack/tools/make_querywise_config.py).
# QUERYWISE_SOURCES_FILE=pack/querywise-sources.json
# Source id selected when nothing was chosen in the UI yet.
# QUERYWISE_DEFAULT_SOURCE=sample
# READ-ONLY reader URLs referenced by that registry (never the migrator accounts):
# QUERYWISE_SQLITE_URL=sqlite:///C:/path/to/pack/output/library.sqlite
# QUERYWISE_POSTGRES_URL=postgresql+psycopg://READER:PASSWORD@localhost:5432/qw_complex_energy
# QUERYWISE_MYSQL_URL=mysql+pymysql://READER:PASSWORD@localhost:3306/qw_complex_retail
# QUERYWISE_MARIADB_URL=mariadb+pymysql://READER:PASSWORD@localhost:3307/qw_complex_freight
# QUERYWISE_SQLSERVER_URL=mssql+pyodbc://READER:PASSWORD@localhost:1433/qw_complex_clinic?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
# QUERYWISE_ORACLE_URL=oracle+oracledb://READER:PASSWORD@localhost:1521/?service_name=FREEPDB1
# QUERYWISE_DB2_URL=ibm_db_sa://READER:PASSWORD@localhost:50000/QWCMPLX
# QUERYWISE_MONGODB_URL=mongodb://READER:PASSWORD@localhost:27017/?authSource=qw_complex_learning
# QUERYWISE_ELASTICSEARCH_URL=https://localhost:9200
# QUERYWISE_ELASTICSEARCH_API_KEY=
# QUERYWISE_EXCEL_PATH=C:/path/to/pack/output/grants/grants-v2.xlsx
# QUERYWISE_PARQUET_PATH=C:/path/to/pack/output/sensors/v2

# --- Migration pack (pack/): MIGRATOR accounts, used only by pack/tools, never by the app ---
# URLs need percent-encoded special characters in username/password.
# PACK_SQLITE_URL=sqlite:///C:/path/to/library.sqlite
# PACK_POSTGRES_URL=postgresql+psycopg://MIGRATOR:PASSWORD@localhost:5432/qw_complex_energy
# PACK_MYSQL_URL=mysql+pymysql://MIGRATOR:PASSWORD@localhost:3306/qw_complex_retail
# PACK_MARIADB_URL=mariadb+pymysql://MIGRATOR:PASSWORD@localhost:3307/qw_complex_freight
# PACK_SQLSERVER_URL=mssql+pyodbc://MIGRATOR:PASSWORD@localhost:1433/qw_complex_clinic?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# PACK_ORACLE_URL=oracle+oracledb://QW_COMPLEX:PASSWORD@localhost:1521/?service_name=FREEPDB1
# PACK_ORACLE_SCHEMA=QW_COMPLEX
# PACK_DB2_URL=ibm_db_sa://MIGRATOR:PASSWORD@localhost:50000/QWCMPLX
# PACK_DB2_SCHEMA=QW_COMPLEX
# PACK_MONGODB_URL=mongodb://MIGRATOR:PASSWORD@localhost:27017/?authSource=admin
# PACK_ELASTICSEARCH_URL=https://localhost:9200
# PACK_ELASTICSEARCH_API_KEY=
# PACK_ELASTICSEARCH_CA_CERT=C:/path/to/http_ca.crt
